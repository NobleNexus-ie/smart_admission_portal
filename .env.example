# Database
DATABASE_URL=postgresql+asyncpg://enrolment:enrolment@enrolment-db:5432/enrolment

# Redis
REDIS_URL=redis://enrolment-redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Mailpit for local)
SMTP_HOST=enrolment-mailpit
SMTP_PORT=1025
EMAIL_FROM=noreply@smartschooladmissions.com

# Object storage (MinIO for local / R2 in production)
S3_ENDPOINT=http://enrolment-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=enrolment-docs
S3_REGION=us-east-1

# Platform
PLATFORM_API_KEY=platform-dev-key-change-me
FRONTEND_URL=http://localhost:3001
REQUIRE_ID_PROOF=true

# LLM / Chatbot (set at least one API key for smart conversation)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gemini-2.5-flash

